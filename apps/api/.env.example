# Example environment variables for apps/api (NestJS + Prisma)

# Postgres connection string used by Prisma and the API server.
# Use a postgres connection string; do NOT commit real credentials. Example format:
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/naijaprice?schema=public"

# (Optional) Shadow DB used for migrations (Prisma Migrate). Only required for some workflows.
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/naijaprice_shadow?schema=public"

# Port the API server listens on (defaults to 3001 in code)
PORT="3001"

# Notes:
# - These values are for local development examples only.
# - Secrets such as API keys, OAuth client ids/secrets, JWT signing keys should NOT be placed in web/.env (use server-only envs here and in deployment secrets).
